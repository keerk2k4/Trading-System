
erDiagram
    users {
        BIGINT user_id PK
        VARCHAR first_name
        VARCHAR last_name
        VARCHAR email UK
        VARCHAR phone UK
        VARCHAR password_hash
        VARCHAR status "ACTIVE, BLOCKED, DEACTIVATED"
        TIMESTAMP updated_at
        TIMESTAMP created_at
    }

    trading_accounts {
        BIGINT trading_account_id PK
        BIGINT user_id FK
        VARCHAR account_number UK
        VARCHAR status "ACTIVE, BLOCKED, CLOSED"
        NUMERIC available_balance
        NUMERIC blocked_balance
        VARCHAR account_status "ACTIVE, BLOCKED, CLOSED"
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    demat_accounts {
        BIGINT demat_account_id PK
        BIGINT user_id FK
        VARCHAR account_number UK
        VARCHAR account_status "ACTIVE, BLOCKED, CLOSED"
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    instruments {
        BIGINT instrument_id PK
        VARCHAR symbol
        VARCHAR exchange "NSE, BSE"
        VARCHAR isin UK
        VARCHAR company_name
        VARCHAR instrument_type "EQUITY, ETF, BOND"
        VARCHAR status "ACTIVE, SUSPENDED, DELISTED"
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    orders {
        BIGINT order_id PK
        BIGINT trading_account_id FK
        BIGINT instrument_id FK
        VARCHAR order_type "MARKET, LIMIT, STOP_LOSS, STOP_LIMIT"
        VARCHAR side "BUY, SELL"
        VARCHAR product_type "INTRADAY, DELIVERY"
        INTEGER quantity
        NUMERIC limit_price
        NUMERIC stop_price
        VARCHAR status "NEW, OPEN, PARTIALLY_FILLED, FILLED, CANCELLED, REJECTED, EXPIRED"
        VARCHAR idempotency_key UK
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    order_history {
        BIGINT history_id PK
        BIGINT order_id FK
        VARCHAR event_type
        VARCHAR old_status
        VARCHAR new_status
        JSONB event_data
        TIMESTAMP created_at
    }

    executions {
        BIGINT execution_id PK
        BIGINT order_id FK
        VARCHAR execution_reference UK
        INTEGER execution_quantity
        NUMERIC execution_price
        TIMESTAMP executed_at
    }

    positions {
        BIGINT position_id PK
        BIGINT trading_account_id FK
        BIGINT instrument_id FK
        VARCHAR product_type "INTRADAY, DELIVERY"
        INTEGER quantity
        NUMERIC average_price
        NUMERIC realized_pnl
        VARCHAR position_status "OPEN, CLOSED"
        TIMESTAMP opened_at
        TIMESTAMP closed_at
        TIMESTAMP updated_at
    }

    settlements {
        BIGINT settlement_id PK
        BIGINT execution_id FK
        BIGINT demat_account_id FK
        INTEGER quantity
        DATE settlement_date
        VARCHAR status "PENDING, PROCESSING, SETTLED, FAILED"
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    holdings {
        BIGINT holding_id PK
        BIGINT demat_account_id FK
        BIGINT instrument_id FK
        INTEGER quantity
        NUMERIC average_price
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    account_transactions {
        BIGINT transaction_id PK
        BIGINT trading_account_id FK
        VARCHAR transaction_type
        NUMERIC amount
        VARCHAR direction "CREDIT, DEBIT"
        VARCHAR reference_type
        BIGINT reference_id
        VARCHAR description
        TIMESTAMP created_at
    }

    watchlist {
        BIGINT watchlist_id PK
        BIGINT user_id FK
        VARCHAR watchlist_name
        TEXT description
        TIMESTAMP created_ts
        TIMESTAMP updated_ts
    }

    watchlist_inst {
        BIGINT wlist_id PK,FK
        BIGINT inst_id PK,FK
    }

    users ||--o{ trading_accounts : "owns"
    users ||--o{ demat_accounts : "owns"
    users ||--o{ watchlist : "creates"
    
    trading_accounts ||--o{ orders : "places"
    trading_accounts ||--o{ positions : "has"
    trading_accounts ||--o{ account_transactions : "records"
    
    demat_accounts ||--o{ holdings : "keeps"
    demat_accounts ||--o{ settlements : "deposits/withdraws from"

    instruments ||--o{ orders : "is traded via"
    instruments ||--o{ positions : "is held in"
    instruments ||--o{ holdings : "is held in"
    instruments ||--o{ watchlist_inst : "is in"

    orders ||--o{ order_history : "generates"
    orders ||--o{ executions : "results in"
    
    executions ||--o| settlements : "settles via"

    watchlist ||--o{ watchlist_inst : "contains"
